# A street corner at night: a pavement slab (top at y = 0), a shop front
# at the back (-z) with a glazed window and a glowing sign, a lamp post
# with a glass lantern round a glowing bulb, a bench under it, a litter
# bin, a small tree and two bollards along the kerb. Metres.
use "std/furniture" as f
use "std/plants"
set grid 240
set ambient 1.6

# --- pavement ---------------------------------------------------------
pavement = box(6, 0.15, 6) | move(0, -0.075, 0) | paint(material("concrete", scale=0.12))

# --- shop front -------------------------------------------------------
wall_z = -2.65
wall = box(4.6, 3.2, 0.5) | move(0, 1.6 - 0.06, wall_z) | paint(material("brick", scale=0.25))
window_cut = box(2.2, 1.5, 0.4) | move(-0.6, 1.3, wall_z + 0.15)
shopfront = wall - window_cut
pane = box(2.2, 1.5, 0.1) | move(-0.6, 1.3, wall_z + 0.2) | paint("glass")
interior = box(2.1, 1.4, 0.12) | move(-0.6, 1.3, wall_z - 0.04) | paint(material("#ffd9a0", glow=0.5))
window = pane + interior
door = box(0.9, 2.15, 0.08) | move(1.5, 1.05, wall_z + 0.26) | paint("walnut")
knob = sphere(0.04) | move(1.2, 1.05, wall_z + 0.29) | paint("brass")
board = box(2.0, 0.5, 0.1) | move(-0.6, 2.75, wall_z + 0.28) | paint("maroon")
letters = extrude(text("CAFE", 0.3, weight=0.07, align="center"), 0.06, "z") | move(-0.6, 2.6, wall_z + 0.35) | paint(material("#ffd060", glow=1.5))
sign = board + letters
shop = shopfront + window + door + knob + sign

# --- lamp post --------------------------------------------------------
post_h = 2.8
column = cylinder(0.05, post_h) | anchor("top", 0, post_h / 2, 0) | move(0, post_h / 2, 0) | paint("iron")
foot = cone(0.16, 0.08, 0.4) | move(0, 0.2, 0) | paint("iron")
collar = cylinder(0.12, 0.1) | anchor("bottom", 0, -0.02, 0) | move(0, 0.05, 0) | paint("iron")   # the anchor sits 0.03 up so the collar sinks a cell into the column
lantern_space = box(0.4, 0.44, 0.4)
lantern = lantern_space | shell(0.05) | paint("glass")
bulb = sphere(0.1) | paint(material("#fff0b0", glow=1.5))
cap = cone(0.3, 0.06, 0.2) | move(0, 0.3, 0) | paint("iron")
stem = cylinder(0.035, 0.2) | move(0, 0.15, 0) | paint("iron")
head = (lantern + bulb + stem + cap) | anchor("base", 0, -0.17, 0) | anchor("bulb", 0, 0, 0)   # base 0.05 above the glass bottom, so the lantern sinks into the collar
head_up = head | attach("base", collar, "top")
collar_up = collar | attach("bottom", column, "top")
head_on = head_up | attach("base", collar_up, "top")
lamp_x = 2.1
lamp_z = 0.5
lamp = (column + foot + collar_up + head_on) | move(lamp_x, -0.06, lamp_z)
bulb_at = at(lamp, "bulb")

# --- furniture --------------------------------------------------------
bench = f.bench(1.6, 0.45) | round(0.02) | move(0.6, -0.055, 0.5)   # round fattens the 0.03 slats to two cells
bin_drum = cylinder(0.2, 0.75) - (cylinder(0.15, 0.6) | move(0, 0.5, 0))
bin = bin_drum | move(0, 0.375 - 0.06, 0) | move(2.6, 0, -1.4) | paint(material("#2e5a3a", metal=0.3, rough=0.5))
tree = plants.tree(2.8) | move(-2.0, -0.06, 0.6)
bollard = cylinder(0.08, 0.9, round=0.03) | move(0, 0.45 - 0.06, 0) | paint("iron")
bollards = place(bollard, [-2.0, 0, 2.5, 0,  1.2, 0, 2.5, 0])

scene pavement, shop, lamp, bench, bin, tree, bollards

# --- promises ---------------------------------------------------------
others = pavement + shop + bench + bin + tree + bollards
head_zone = box(0.6, 0.6, 0.6) | move(bulb_at[0], bulb_at[1], bulb_at[2])
everything = others + lamp
assert clearance(bench, lamp) > 0.3, "the bench is clear of the lamp post"
assert void(head_zone, others), "nothing but the lamp head is round the lamp head"
assert overlap(sign, shopfront) > 0.002, "the sign is joined to the shop"
assert pieces(everything) == 1, "everything rests on the pavement"

# --- lights, cameras, sky ---------------------------------------------
light("moon", azimuth=150, elevation=40, size=2, power=1.1, color="#b8c8ff")
light("lamp", position=[bulb_at[0] - 0.15, bulb_at[1] - 0.24, bulb_at[2] + 0.32], range=3, size=0.5, color="#ffe4a0", power=1.6)
light("sign", position=[-0.6, 2.75, wall_z + 0.7], range=2.5, size=0.5, color="#ffd060", power=1.2)
camera("wide", azimuth=30, elevation=16, zoom=1.15)
camera("window", focus="window", azimuth=20, elevation=8, zoom=0.9)
camera("low", focus="bench", azimuth=-40, elevation=-2, zoom=0.6)
set camera wide
set environment night
