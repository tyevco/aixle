# A lighthouse on a rocky outcrop, with a keeper's cottage and a stone path.
# Unit: about a metre. Front is +z. Everything stands on y = 0.
set grid 220

# ---- rocks --------------------------------------------------------------
rock_a = ellipsoid(4.5, 1.1, 3.2) | move(-1.0, 0.0, 0.0)
rock_b = ellipsoid(3.0, 0.9, 2.6) | move(2.3, 0.0, 0.3)
rock_c = ellipsoid(2.0, 1.3, 1.8) | move(-2.0, 0.0, -0.8)
rock_d = ellipsoid(1.6, 0.7, 1.4) | move(1.0, 0.0, 2.4)
rock_blob = union(rock_a, rock_b, rock_c, rock_d, k=0.6) | displace(0.18, 0.9)
shelf_y = 0.8
shelf = box(3.8, shelf_y, 5.0, round=0.1) | move(2.1, shelf_y / 2, 1.1)   # a flat ledge for the cottage and path
shelf_cut = box(3.8, 4, 5.0) | move(2.1, shelf_y + 2, 1.1)               # cut the rock down to the ledge's height there
above_ground = box(14, 6, 14) | move(0, 3, 0)                            # keep only what is above y = 0
rocks = (union(difference(rock_blob, shelf_cut, k=0.15), shelf, k=0.3) & above_ground) | paint("granite")

# ---- tower --------------------------------------------------------------
tower_h = 5.4
tower_x = -1.5
shaft = cone(1.05, 0.72, tower_h) | move(0, tower_h / 2, 0)
slabs = empty()
for i in range(3) {
  slabs = slabs + (box(3, 1.0, 3) | move(0, 0.5 + i * 2.0, 0))
}
shaft_red = (shaft & slabs) | paint("red")
shaft_white = (shaft - slabs) | paint("white")
gallery = cylinder(1.15, 0.18) | move(0, tower_h + 0.09, 0) | paint("charcoal")
post = cylinder(0.05, 0.8) | move(0, tower_h + 0.18 + 0.4, 0)
posts = post | ring(14, 1.05) | paint("charcoal")
rail = torus(1.05, 0.045) | move(0, tower_h + 0.98, 0) | paint("charcoal")
lantern_h = 1.2
lantern_y = tower_h + 0.18
glazing = cylinder(0.62, lantern_h) | move(0, lantern_y + lantern_h / 2, 0) | paint("glass")
mullion = box(0.09, lantern_h, 0.09) | move(0.62, lantern_y + lantern_h / 2, 0)
mullions = mullion | ring(8, 0) | paint("charcoal")
lamp = sphere(0.3) | move(0, lantern_y + lantern_h / 2, 0) | paint("yellow")
cap = cone(0.82, 0.12, 0.75) | move(0, lantern_y + lantern_h + 0.75 / 2, 0) | paint("red")
finial = sphere(0.12) | move(0, lantern_y + lantern_h + 0.8, 0) | paint("brass")
tower = (shaft_red + shaft_white + gallery + posts + rail + glazing + mullions + lamp + cap + finial)
  | move(tower_x, 0, 0)

# ---- cottage ------------------------------------------------------------
cot_w = 2.4
cot_h = 1.7
cot_d = 2.0
cot_x = 2.0
floor_y = shelf_y - 0.02
walls = box(cot_w, cot_h + floor_y, cot_d) | move(0, (cot_h + floor_y) / 2, 0) | paint("cream")   # walls run down to y = 0 inside the shelf
roof_profile = polygon(-(cot_w / 2 + 0.25), 0, cot_w / 2 + 0.25, 0, 0, 1.0)
roof = extrude(roof_profile, cot_d + 0.4, "z") | move(0, floor_y + cot_h - 0.02, 0) | paint("maroon")
chimney = box(0.36, 1.4, 0.36) | move(0.7, floor_y + cot_h + 0.6, -0.4) | paint("brick")
door = box(0.5, 1.0, 0.08) | move(0, floor_y + 0.5, cot_d / 2) | paint("walnut")
window_a = box(0.45, 0.45, 0.08) | move(-0.7, floor_y + 1.05, cot_d / 2) | paint("sky")
window_b = box(0.45, 0.45, 0.08) | move(0.7, floor_y + 1.05, cot_d / 2) | paint("sky")
cottage = (walls + roof + chimney + door + window_a + window_b) | move(cot_x, 0, 0)

# ---- path ---------------------------------------------------------------
stone = ellipsoid(0.3, 0.07, 0.24) | displace(0.02, 0.2) | paint("stone")
stone_y = shelf_y + 0.02
path = place(stone, [
  2.0, stone_y, 1.35, 10,
  2.15, stone_y, 1.85, -20,
  1.95, stone_y, 2.35, 30,
  2.1, stone_y, 2.85, -10,
  2.3, stone_y, 3.2, 15
])

scene tower, cottage, rocks, path
