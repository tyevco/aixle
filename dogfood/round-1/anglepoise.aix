# An anglepoise desk lamp. Unit: 1 = 10 cm. Front is +z; every hinge turns about x,
# so a positive pose angle tips the part forward (+y towards +z).
# Rest pose: arms straight up, shade pointing forward (+z).
set grid 200

# pivot heights and arm lengths
shoulder_y = 0.8
lower_len = 1.7
elbow_y = shoulder_y + lower_len
upper_len = 1.5
wrist_y = elbow_y + upper_len

# ---- base ----
base_disc = cylinder(1.0, 0.3, round=0.04) | move(0, 0.15, 0) | paint("charcoal")
base_top = cylinder(0.5, 0.14, round=0.03) | move(0, 0.36, 0) | paint("charcoal")
column = cylinder(0.12, 0.5) | move(0, 0.6, 0) | paint("iron")
maker = extrude(text("AIXLE", size=0.16, weight=0.06, align="center"), 0.04)
      | move(0, 0.29, 0.6) | paint("silver")
switch = box(0.18, 0.08, 0.12, round=0.02) | move(-0.55, 0.32, 0.4) | paint("red")
base = base_disc + base_top + column + maker + switch

# ---- parts shared by both arms ----
def rod(len, y0, x) = cylinder(0.035, len) | move(x, y0 + len / 2, 0)
def hinge_disc(y, r=0.14, w=0.34) = cylinder(r, w) | rotate(z=90) | move(0, y, 0)
def cross_bar(y, w) = cylinder(0.03, w) | rotate(z=90) | move(0, y, 0)
def spring(y0, len, x) = tube(0.018, helix(0.05, len, 12)) | move(x, y0, 0)

# ---- lower arm: twin rods from the shoulder pivot, a hinge disc, two tension springs ----
lower_rods = (rod(lower_len, shoulder_y, 0.09) + rod(lower_len, shoulder_y, -0.09)) | paint("cream")
shoulder_disc = hinge_disc(shoulder_y) | paint("black")
lower_bars = (cross_bar(shoulder_y + 0.15, 0.5) + cross_bar(shoulder_y + 0.7, 0.5)) | paint("black")
lower_springs = (spring(shoulder_y + 0.15, 0.55, 0.22) + spring(shoulder_y + 0.15, 0.55, -0.22)) | paint("steel")
lower_arm_body = lower_rods + shoulder_disc + lower_bars + lower_springs

# ---- upper arm: narrower twin rods from the elbow pivot, its own disc and one spring ----
upper_rods = (rod(upper_len, elbow_y, 0.05) + rod(upper_len, elbow_y, -0.05)) | paint("cream")
elbow_disc = hinge_disc(elbow_y) | paint("black")
upper_bars = (cross_bar(elbow_y + 0.15, 0.4) + cross_bar(elbow_y + 0.85, 0.4)) | paint("black")
upper_spring = spring(elbow_y + 0.15, 0.7, 0.17) | paint("steel")
upper_arm_body = upper_rods + elbow_disc + upper_bars + upper_spring

# ---- shade: a small wrist disc, a neck along +z, a hollow cone open towards +z, a bulb ----
wrist_disc = hinge_disc(wrist_y, 0.1, 0.2) | paint("black")
neck = cylinder(0.03, 0.35) | rotate(x=90) | move(0, wrist_y, 0.17) | paint("black")
# built pointing -y (wide end down), hollowed, the wide end cut open, then turned to point +z
cone_shell = shell(cone(0.5, 0.18, 0.6), 0.06) - (box(1.2, 0.4, 1.2) | move(0, -0.48, 0))
shade_cone = cone_shell | rotate(x=-90) | move(0, wrist_y, 0.62) | paint("cream")
shade_cap = sphere(0.19) | move(0, wrist_y, 0.33) | paint("cream")
bulb = sphere(0.12) | move(0, wrist_y, 0.55) | paint("yellow")
shade_body = wrist_disc + neck + shade_cone + shade_cap + bulb

# ---- rig: wrist inside elbow inside shoulder ----
shade_part = joint(shade_body, "wrist", 0, wrist_y, 0)
upper_arm = joint(upper_arm_body + shade_part, "elbow", 0, elbow_y, 0)
lower_arm = joint(lower_arm_body + upper_arm, "shoulder", 0, shoulder_y, 0)
lamp = base + lower_arm

# lower arm leans back, upper arm folds forward over it, shade hangs over the base
pose("folded", shoulder=[-55, 0, 0], elbow=[140, 0, 0], wrist=[-25, 0, 0])
# both arms reach forward, shade points straight down at the desk
pose("reading", shoulder=[40, 0, 0], elbow=[75, 0, 0], wrist=[-25, 0, 0])
# nearly straight up, shade tilted down and forward
pose("raised", shoulder=[-10, 0, 0], elbow=[20, 0, 0], wrist=[20, 0, 0])
animation("unfold", ["folded", "reading", "raised", "folded"], seconds=3)

set pose reading
show lamp
