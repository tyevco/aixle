# An award trophy, about 5 units tall, front on +z.
# Stepped marble base with an engraved silver nameplate, a twisted gold stem,
# a gold cup with two swept handles, "CHAMPION" wrapped around the rim,
# and a star on a post above the bowl.
set grid 240
set size 768
set azimuth 22
set elevation 18
set light_size 1.5

shine = material("#f2c94c", metal=0.5, rough=0.15)   # the gold preset reads as dull brown in the beauty render
silver = material("#e6e9ee", metal=0.5, rough=0.2)

# --- base ---
step1 = box(3.4, 0.6, 3.4, round=0.04) | paint(material("marble", scale=0.4)) | move(0, 0.3, 0)
step2 = box(2.6, 0.4, 2.6, round=0.04) | paint(material("marble", scale=0.4)) | move(0, 0.8, 0)
collar = cylinder(0.55, 0.14) | paint(silver) | move(0, 1.05, 0)

# --- nameplate, engraved (cut into the plate) ---
plate = box(2.6, 0.56, 0.12, round=0.01) | paint(silver) | move(0, 0.3, 1.72)
line1 = extrude(text("GRAND CHAMPION", size=0.17, weight=0.055, align="center"), 0.3, "z") | move(0, 0.335, 1.78)
line2 = extrude(text("AIXLE OPEN 2026", size=0.17, weight=0.055, align="center"), 0.3, "z") | move(0, 0.095, 1.78)
nameplate = plate - line1 - line2

# --- twisted stem ---
stem = extrude(star(8, 0.36, 0.28), 1.4) | twist(50) | paint(shine) | move(0, 1.8, 0)
collar2 = cylinder(0.5, 0.14) | paint(silver) | move(0, 2.5, 0)

# --- cup ---
bowl = revolve(polygon(0,0, 0.35,0, 0.5,0.15, 0.55,0.4, 0.9,1.0, 1.25,1.6, 1.3,1.75, 1.3,2.0, 0,2.0))
cavity = revolve(polygon(0,0.9, 0.5,0.9, 0.8,1.05, 1.15,1.62, 1.2,1.78, 1.2,2.2, 0,2.2))
cup = (bowl - cavity) | paint(shine) | move(0, 2.5, 0)

# --- handles: an ellipse swept along a spline, mirrored ---
handle_path = spline([0.62,3.2,0, 1.75,3.3,0, 1.95,3.9,0, 1.22,4.12,0])   # top end below the rim text band
handle = sweep(ellipse(0.07, 0.13), handle_path) | mirror("x") | paint(shine)

# --- rim lettering: one standing letter per step around the rim band ---
# The cup's rim band is a cylinder r=1.3 from y 4.25 to 4.5 (cup local 1.75..2.0).
# Each letter is extruded facing +z, pushed out to the band, then turned about y.
letters = ["C", "H", "A", "M", "P", "I", "O", "N"]
n = len(letters)
i = 0
rim = empty()
for c in letters {
  rim = rim + (extrude(text(c, size=0.18, weight=0.06, align="center"), 0.12, "z") | move(0, 4.28, 1.3) | rotate(y = (i - (n - 1) / 2) * 13))
  i = i + 1
}
rim = rim | paint(silver)

# --- star finial on a post through the bowl ---
post = cylinder(0.08, 1.3) | paint(shine) | move(0, 4.0, 0)
# The star's inner (concave) vertices sit 0.18 below its centre, so the centre
# must be within 0.18 + 0.15 of the knob's centre for the two to overlap.
knob = sphere(0.15) | paint(shine) | move(0, 4.72, 0)
star_top = extrude(star(5, 0.42, 0.18), 0.12, "z") | paint(shine) | move(0, 4.94, 0)

trophy = (step1 + step2 + collar + nameplate + stem + collar2 + cup + handle + rim + post + knob + star_top) | ground()
show trophy
