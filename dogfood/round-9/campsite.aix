# A campsite at night, about 6 units across on a ground slab whose top is y = 0.
# The fire is at the origin inside a ring of stones; a ridge tent at the back
# left with its door towards the fire; a lantern on a pole at the front right;
# a split-log bench in front of the fire; a stack of firewood at the back right.
set grid 200
set azimuth 35
set elevation 22

# ---- ground: a slab whose top face is y = 0, so everything else stands on 0
ground = box(6, 0.12, 6) | move(0, -0.06, 0) | paint(material("dirt", scale=0.4))

# ---- tent: a triangular prism, hollowed, with a door cut in the front wall.
# Built facing +z (door on +z), then turned to face the fire.
tent_w = 1.9
tent_h = 1.2
tent_d = 1.7
wall = 0.06
tent_yaw = 35
def place_tent(s) = s | rotate(y=tent_yaw) | move(-1.7, 0, -1.3)
tri = polygon(-tent_w / 2, 0, tent_w / 2, 0, 0, tent_h)
tent_solid = extrude(tri, tent_d, "z")
tent_shell = tent_solid | shell(wall)
door = extrude(polygon(-0.3, 0, 0.3, 0, 0, 0.75), 0.4, "z") | move(0, 0.02, tent_d / 2)
tent_body = (tent_shell - door) | paint(material("#6f7a48", rough=0.9))
tent = place_tent(tent_body)
# a named region for the tent's inside: the shell's void, kept a little inside the walls
tent_void = place_tent(extrude(polygon(-0.7, 0.08, 0.7, 0.08, 0, 0.95), tent_d - 0.25, "z"))

# ---- campfire: four logs leaning together, and a glowing flame in two tones
def fire_log(a) = cylinder(0.07, 0.75) | rotate(x=62) | move(0, 0.2, 0) | rotate(y=a) | paint(material("#5a3a22", "wood", "#3a2414", scale=0.15))
logs = fire_log(0) + fire_log(90) + fire_log(180) + fire_log(270)
flame_outer = union(cone(0.22, 0, 0.6) | move(0, 0.3, 0), cone(0.12, 0, 0.55) | move(0.12, 0.35, 0.05), cone(0.1, 0, 0.5) | move(-0.1, 0.3, -0.08), k=0.08) | paint(material("#ff7a18", glow=1.0))
flame_core = cone(0.12, 0, 0.4) | move(0, 0.22, 0) | paint(material("#fff08a", glow=1.6))
flame = flame_outer + flame_core
embers = sphere(0.16) | scale(1, 0.5, 1) | move(0, 0.1, 0) | paint(material("#ff5a10", glow=1.2))
campfire = logs + flame + embers

# ---- stone ring: eleven stones on a circle of radius 0.72, each a little different
stones = empty()
ring_r = 0.72
for i in range(11) {
  a = i * 360 / 11
  s = 0.85 + 0.3 * rand(i)
  stones = stones + (ellipsoid(0.17, 0.11, 0.13) | scale(s) | rotate(y=a + 40 * rand(i + 20)) | move(ring_r * sin(a), 0.09 * s, ring_r * cos(a)))
}
stones = stones | paint(material("stone", scale=0.12))
# the hearth: the air inside the ring, where the flame must sit
hearth = cylinder(ring_r - 0.16, 1.2) | move(0, 0.6, 0)

# ---- lantern on a pole: a pole in a stump, a hooked arm, and a glass lantern hanging from the arm's tip.
# Every part is built in the pole's frame and placed with the same helper, so the
# placed steps have their own names for focus and for the promises.
pole_h = 2.0
def place_pole(s) = s | rotate(y=-30) | move(2.1, 0, 0.9)
stump = place_pole(cylinder(0.3, 0.12, round=0.03) | move(0, 0.06, 0)) | paint("walnut")
pole = place_pole(cylinder(0.04, pole_h) | move(0, pole_h / 2, 0)) | paint("walnut")
arm = place_pole(tube(0.03, [0, pole_h - 0.05, 0, -0.45, pole_h - 0.05, 0])) | paint("walnut")
hang_y = pole_h - 0.05
top_y = hang_y - 0.12
shade_h = 0.3
hook = place_pole(torus(0.045, 0.02) | rotate(x=90) | move(-0.45, hang_y - 0.05, 0)) | paint("iron")
cap_top = place_pole(cylinder(0.12, 0.07) | move(-0.45, top_y - 0.035, 0)) | paint("iron")
shade_space = place_pole(cylinder(0.11, shade_h) | move(-0.45, top_y - 0.07 - shade_h / 2, 0))
shade = shade_space | shell(0.05) | paint("glass")
cap_bottom = place_pole(cylinder(0.12, 0.07) | move(-0.45, top_y - 0.07 - shade_h - 0.03, 0)) | paint("iron")
mantle = place_pole(cylinder(0.03, 0.2, round=0.015) | move(-0.45, top_y - 0.07 - shade_h / 2, 0)) | paint(material("#fff2b0", glow=2))
lantern_head = hook + cap_top + shade + cap_bottom + mantle
lantern = stump + pole + arm + lantern_head

# ---- bench: a split log on two short log feet, in front of the fire
log_r = 0.19
seat_log = cylinder(log_r, 1.6) | rotate(z=90) | move(0, 0.32, 0)
seat = (seat_log - (box(2, 0.3, 0.6) | move(0, 0.32 + 0.12 + 0.15, 0))) | paint(material("oak", scale=0.2))
foot = cylinder(0.09, 0.32) | move(0, 0.16, 0) | paint("walnut")
feet = (foot | move(-0.55, 0, 0)) + (foot | move(0.55, 0, 0))
bench = (seat + feet) | move(0, 0, 1.45)

# ---- firewood: a 3-2-1 stack of logs lying along x, at the back right, each row sunk a cell into the one below
def wood_log(x, y, z) = cylinder(0.09, 0.7) | rotate(z=90) | move(x, y, z) | paint(material("#8a5a34", "wood", "#5a3a20", scale=0.12))
firewood_stack = wood_log(0, 0.09, -0.22) + wood_log(0, 0.09, 0) + wood_log(0, 0.09, 0.22)
  + wood_log(0, 0.19, -0.11) + wood_log(0, 0.19, 0.11)
  + wood_log(0, 0.29, 0)
firewood = firewood_stack | rotate(y=-25) | move(1.7, 0, -1.5)

scene tent, ground, campfire, stones, lantern, bench, firewood

# ---- promises
others = campfire + stones + lantern + bench + firewood
assert void(tent_void, tent) == 1, "the tent's own walls stay out of its inside"
assert void(tent_void, others) == 1, "nothing else pokes into the tent"
assert inside(flame, hearth) == 1, "the flame sits inside the stone ring"
assert inside(mantle, shade_space) == 1, "the mantle is inside its shade"
assert overlap(shade, pole) < 0.0001, "the shade does not overlap the pole"
assert clearance(bench, campfire) > 0.4, "the bench clears the fire"

# ---- lights, cameras, sky
light("moon", azimuth=140, elevation=65, size=2.5, color="#9fb4dc", power=0.9)
light("fire", azimuth=20, elevation=35, size=1.5, color="#ff9a3c", power=0.6)
camera("wide", azimuth=35, elevation=26, zoom=1.3)
camera("lantern", focus="lantern_head", azimuth=-110, elevation=15, zoom=0.8)
camera("fireside", focus="stones", azimuth=-25, elevation=12, zoom=1)
set camera wide
set environment night
set ambient 1.6
