# A machined L-bracket for a print: a base plate on y = 0, an upright at the
# back (-z) with a cove fillet where they meet, a centre gusset, four
# counterbored bolt holes through the base, a slot through the upright, two
# dowel pins standing in the base, and a part number engraved on the upright.
# One unit is about 10 cm; the part is 1.5 long along x.

set grid 200

# --- plates ---------------------------------------------------------------
base    = box(1.5, 0.15, 1.0) | move(0, 0.075, 0)
upright = box(1.5, 1.0, 0.15) | move(0, 0.5, -0.425)

# A cove fillet in the inside corner: a bar sunk 0.01 into both plates, minus a cylinder along x.
cove_bar = box(1.5, 0.11, 0.11) | move(0, 0.195, -0.305)
cove_cut = cylinder(0.1, 1.6) | rotate(z=90) | move(0, 0.25, -0.25)
fillet   = cove_bar - cove_cut

# A triangular gusset on the centre line, drawn as a side profile (x along -z) and extruded along x.
gusset = extrude(polygon(0.42,0.1, -0.32,0.1, 0.42,0.5), 0.12, "x")

body = (base + upright + fillet + gusset) | paint("steel")

# --- cutters --------------------------------------------------------------
# Bolt holes: a through hole 0.12 across and a counterbore 0.22 across, 0.06 deep, from the top.
def thru(x, z)  = cylinder(0.06, 0.5) | move(x, 0.075, z)
def cbore(x, z) = cylinder(0.11, 0.2) | move(x, 0.19, z)
hole_fl = thru(-0.55, 0.35)
hole_fr = thru(0.55, 0.35)
hole_bl = thru(-0.55, -0.1)
hole_br = thru(0.55, -0.1)
cbore_fl = cbore(-0.55, 0.35)
cbore_fr = cbore(0.55, 0.35)
cbore_bl = cbore(-0.55, -0.1)
cbore_br = cbore(0.55, -0.1)

# A slot through the upright, rounded ends, longer than the plate is thick.
slot = box(0.5, 0.12, 0.4, round=0.05) | move(0, 0.6, -0.425)

# The part number, 0.02 deep into the upright's front face (z = -0.35).
label  = extrude(text("BRK-2041", 0.12, weight=0.03, align="center"), 0.04, "z") | move(0, 0.78, -0.35)

# Each cutter subtracted on its own: void(region, body - (a + b)) reports solid in b when b overlaps a
# (a through hole inside its counterbore), though the mesh is clean; see dogfood/bracket_probe_void*.aix.
plate = body - cbore_fl - cbore_fr - cbore_bl - cbore_br - hole_fl - hole_fr - hole_bl - hole_br - slot - label

# --- pins -----------------------------------------------------------------
pin_l = cylinder(0.05, 0.37) | move(-0.3, 0.265, 0.32) | paint("iron")
pin_r = cylinder(0.05, 0.37) | move(0.3, 0.265, 0.32) | paint("iron")

bracket = plate + pin_l + pin_r

# --- promises -------------------------------------------------------------
# "Goes through" is tested with a rod thinner and longer than the cutter, reaching past both faces,
# since a region that is the cutter itself is empty by construction even when the cut is a buried pocket.
def rod(x, z) = cylinder(0.04, 0.3) | move(x, 0.075, z)
rod_fl = rod(-0.55, 0.35)
rod_fr = rod(0.55, 0.35)
rod_bl = rod(-0.55, -0.1)
rod_br = rod(0.55, -0.1)
slot_rod = box(0.4, 0.06, 0.3) | move(0, 0.6, -0.425)
assert void(rod_fl, bracket), "front-left hole goes through"
assert void(rod_fr, bracket), "front-right hole goes through"
assert void(rod_bl, bracket), "back-left hole goes through"
assert void(rod_br, bracket), "back-right hole goes through"
assert void(cbore_fl, bracket), "front-left counterbore is empty"
assert void(cbore_fr, bracket), "front-right counterbore is empty"
assert void(cbore_bl, bracket), "back-left counterbore is empty"
assert void(cbore_br, bracket), "back-right counterbore is empty"
assert void(slot_rod, bracket), "the slot is clear through the upright"
assert overlap(pin_l, base) > 0.0004, "left pin is sunk into the base"
assert overlap(pin_r, base) > 0.0004, "right pin is sunk into the base"
assert clearance(pin_l, pin_r) > 0.1, "the pins do not touch"
assert pieces(bracket) == 1, "one piece"
# Behind the engraving: a box from 0.04 deep to the back of the upright, over the label's area, must be solid.
behind = box(0.9, 0.2, 0.09) | move(0, 0.85, -0.445)
assert inside(behind, bracket) > 0.999, "the engraving does not break through"

# --- presentation ---------------------------------------------------------
light("key", azimuth=-35, elevation=50, size=3, color="#fff4e6")
light("fill", azimuth=70, elevation=25, size=2, power=0.4, color="#dde8ff")
camera("iso", azimuth=40, elevation=32, zoom=1.15)
camera("top", azimuth=0, elevation=90, zoom=1.3)
camera("cbore", focus="cbore_fr", zoom=2, dof=0.4)
set camera iso
set environment overcast

show bracket
