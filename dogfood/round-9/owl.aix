# An owl money box perched on a branch, about 1.4 tall, facing +z.
# The body is a hollow shell with a coin slot in the back and a rubber plug
# underneath; the head turns on the joint "head" about y.
set grid 160

# --- the branch and the ground -------------------------------------------
branch = tube(0.1, [-0.9, 0.1, 0, -0.3, 0.1, 0.02, 0.3, 0.1, -0.02, 0.9, 0.1, 0], smooth=4) | paint("walnut")

# --- the body: a shell with a slot and a plug hole --------------------------
body_y = 0.6
body_solid = ellipsoid(0.36, 0.34, 0.34) | move(0, body_y, 0)
body_shell = shell(body_solid, 0.06)
slot_cut = box(0.16, 0.035, 0.3) | move(0, 0.72, -0.35)
plug_hole = cylinder(0.1, 0.3) | move(0, 0.26, 0)
body_cut = body_shell - slot_cut - plug_hole
feathers = material("#8a6a48", "noise", "#5a4128", scale=0.08)
body = body_cut | paint(feathers) | decal(ellipsoid(0.2, 0.24, 0.2) | move(0, 0.56, 0.3), material("#e8d8b8", "noise", "#b49c78", scale=0.08))
# the cavity: the inner surface with a margin, for the void promise
cavity = ellipsoid(0.27, 0.25, 0.25) | move(0, body_y, 0)
# a region through the slot: outside air, the wall, the cavity
slot_region = box(0.12, 0.025, 0.14) | move(0, 0.72, -0.31)

plug = (cylinder(0.11, 0.09) | move(0, 0.29, 0)) + (cylinder(0.14, 0.03) | move(0, 0.245, 0))
plug_p = plug | paint("rubber")

neck = cylinder(0.09, 0.2) | move(0, 1.0, 0) | paint(feathers)

# --- the wings, folded against the body ------------------------------------
# a wing is a skin of the body's own surface: a layer 0.05 proud of it and a cell into it, cut to an oval
wing_skin = offset(body_solid, 0.05) - offset(body_solid, -0.012)
wing_l = intersect(wing_skin, ellipsoid(0.2, 0.27, 0.18) | rotate(x=-12) | move(0.36, 0.58, -0.04), k=0.04)
wing_r = wing_l | flip("x")
wings = (wing_l + wing_r) | paint(material("#5a4128", "noise", "#3a2818", scale=0.08))

# --- the tail: three feathers fanned down and back ---------------------------
feather = box(0.09, 0.04, 0.24, round=0.015)
tail_c = feather | rotate(x=-35) | move(0, 0.38, -0.4)
tail_l = feather | rotate(x=-35, y=18) | move(0.08, 0.38, -0.39)
tail_r = feather | rotate(x=-35, y=-18) | move(-0.08, 0.38, -0.39)
tail = (tail_c + tail_l + tail_r) | paint(material("#5a4128", "noise", "#3a2818", scale=0.08))

# --- the feet gripping the branch ------------------------------------------
def leg(x) = tube(0.045, [x, 0.3, 0.02, x, 0.2, 0.02])
def toe_front(x) = tube(0.024, curve(arc(0.108, -40, 100))) | rotate(z=90) | move(x, 0.1, 0)
def toe_back(x) = tube(0.024, curve(arc(0.108, 95, 215))) | rotate(z=90) | move(x, 0.1, 0)
def foot(x) = leg(x) + toe_front(x - 0.062) + toe_front(x) + toe_front(x + 0.062) + toe_back(x)
feet = (foot(0.15) + foot(-0.15)) | paint("#d8a040")

# --- the head, on a joint about y ------------------------------------------
head_y = 1.19
head_ball = ellipsoid(0.27, 0.22, 0.25) | move(0, head_y, 0)
tuft = cone(0.05, 0.006, 0.14) | rotate(z=-25) | move(0.19, 1.42, -0.02)
tufts = tuft | mirror("x")
beak = cone(0.045, 0.004, 0.13) | rotate(x=110) | move(0, 1.14, 0.22) | paint("#d8a040")
# eye regions: spheres centred a little outside the face so they cross it
eye_l = sphere(0.1) | move(0.115, 1.21, 0.24)
eye_r = eye_l | flip("x")
pupil_l = sphere(0.045) | move(0.105, 1.21, 0.27)
pupil_r = pupil_l | flip("x")
face = (head_ball + tufts) | paint(feathers)
  | decal(eye_l, "ivory") | decal(eye_r, "ivory")
  | decal(pupil_l, "black") | decal(pupil_r, "black")
head_part = face + beak
head = joint(head_part, "head", 0, 1.0, 0)

owl = branch + body + plug_p + neck + wings + tail + feet + head
show owl

# --- poses and the scan animation -------------------------------------------
pose("look_left", head=[0, 60, 0])
pose("look_right", head=[0, -60, 0])
pose("curious", head=xform(rotate=[0, 35, 14]))
animation("scan", ["rest", "look_left", "curious", "look_right", "rest"], seconds=4, ease=1, ease_ends=0)

# --- promises ---------------------------------------------------------------
assert pieces(owl) == 1, "one piece"
assert void(cavity, owl), "the money box holds nothing"
assert void(cavity, owl), "the money box holds nothing with the head turned", pose=look_left
assert void(slot_region, owl), "the coin slot goes through into the cavity"
assert overlap(wing_l, body) > 0.0001, "the left wing is joined to the body"
assert overlap(wing_l, body) < 0.004, "the left wing sits on the body, not sunk in"
assert overlap(eye_l, head_ball) > 0.0001, "the left eye region crosses the face"
assert overlap(eye_r, head_ball) > 0.0001, "the right eye region crosses the face"
assert clearance(head, body) > 0.01, "the head clears the body when turned", pose=look_left
assert clearance(head, body) > 0.005, "the head clears the body when tilted", pose=curious

# --- lights and shots -------------------------------------------------------
light("key", azimuth=-35, elevation=50, size=1.5, color="#fff0dc")
light("rim", azimuth=150, elevation=35, power=1.2, color="#cfe0ff")
camera("portrait", azimuth=25, elevation=12, zoom=1.3)
camera("eye", focus="eye_l", zoom=2, dof=1)
camera("back", azimuth=180, elevation=20, zoom=1.2)
set camera portrait
set environment studio
