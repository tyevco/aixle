# A sailing dinghy on a cradle, about 5 units long. Bow is +z. The cradle
# stands on y = 0 and the hull's keel is `up` above it; nothing is grounded
# or moved after the joints are declared, because a transform above a
# joint is not carried into the GLB's joint nodes (measured: the boom and
# rudder came out one unit low when the assembly was grounded).
set grid 320
set azimuth -40
set elevation 18
set light_azimuth -75
set light_elevation 45
set light_size 1.5
set zoom 1.25
up = 1.0

# ---------- materials ----------
topside = material("#1e4d8f", rough=0.25)
boot = material("#f4f4f2", rough=0.3)
antifoul = material("#b3382c", rough=0.6)
deckpaint = material("#efe6cf", rough=0.7)
cockpitpaint = material("#d8cfb8", rough=0.7)
varnish = material("oak", rough=0.25)
sailcloth = material("#f6f2e6", rough=0.8)
spar = material("silver", rough=0.5)
foil = material("#e8e4dc", rough=0.4)

# ---------- hull ----------
# Stations as z, half-beam pairs, stern to bow; the tip is the bow point.
keel_st = [-2.25, 0.05, -2.0, 0.1, -1.4, 0.15, -0.7, 0.17, 0, 0.17, 0.7, 0.15, 1.2, 0.1, 1.5, 0.05]
keel_tip = 1.75
chine_st = [-2.35, 0.42, -2.0, 0.56, -1.4, 0.68, -0.7, 0.75, 0, 0.76, 0.7, 0.7, 1.4, 0.52, 1.9, 0.28, 2.15, 0.1]
chine_tip = 2.25
sheer_st = [-2.4, 0.55, -2.0, 0.72, -1.4, 0.88, -0.7, 0.98, 0, 1.0, 0.7, 0.95, 1.4, 0.78, 2.0, 0.45, 2.35, 0.18]
sheer_tip = 2.5

# A profile lies with its y along -z when lofted, so profile y = -z.
keel_pts = []
n = len(keel_st) / 2
for i in range(n) { keel_pts = keel_pts + [keel_st[2 * i + 1], -keel_st[2 * i]] }
keel_pts = keel_pts + [0, -keel_tip]
for i in range(n) { j = n - 1 - i
  keel_pts = keel_pts + [-keel_st[2 * j + 1], -keel_st[2 * j]] }
keel_p = polygon(keel_pts)

chine_pts = []
n = len(chine_st) / 2
for i in range(n) { chine_pts = chine_pts + [chine_st[2 * i + 1], -chine_st[2 * i]] }
chine_pts = chine_pts + [0, -chine_tip]
for i in range(n) { j = n - 1 - i
  chine_pts = chine_pts + [-chine_st[2 * j + 1], -chine_st[2 * j]] }
chine_p = polygon(chine_pts)

sheer_pts = []
n = len(sheer_st) / 2
for i in range(n) { sheer_pts = sheer_pts + [sheer_st[2 * i + 1], -sheer_st[2 * i]] }
sheer_pts = sheer_pts + [0, -sheer_tip]
for i in range(n) { j = n - 1 - i
  sheer_pts = sheer_pts + [-sheer_st[2 * j + 1], -sheer_st[2 * j]] }
sheer_p = polygon(sheer_pts)

# Two lofts stacked: keel to chine, chine to (above) the sheer. loft() is
# centred on y = 0 (check showed -0.15..0.15), so each is lifted by half.
chine_y = 0.3
loft_top = 1.1
lower_hull = loft(keel_p, chine_p, chine_y) | move(0, up + chine_y / 2, 0)
upper_hull = loft(chine_p, sheer_p, loft_top - chine_y) | move(0, up + (chine_y + loft_top) / 2, 0)
hull_block = lower_hull + upper_hull

# Sheer: cut the top with a big cylinder lying along x, so the deck curves
# up towards bow and stern; sheer(z) is the deck height. Rocker: keep only
# what is inside a cylinder resting on the keel, so the keel line rises
# towards both ends.
sheer_r = 11
sheer_mid = 0.8
def sheer(z) = up + sheer_mid + sheer_r - sqrt(sheer_r * sheer_r - z * z)
sheer_cutter = cylinder(sheer_r, 6) | rotate(z=90) | move(0, up + sheer_mid + sheer_r, 0)
rocker_r = 12
rocker_keep = cylinder(rocker_r, 6) | rotate(z=90) | move(0, up + rocker_r, 0)
hull_shaped = (hull_block - sheer_cutter) & rocker_keep

# Cockpit: a rounded trapezoid well, wider forward, floor 0.35 above the keel.
cockpit_floor = up + 0.35
cockpit_plan = polygon(-0.58, -0.3, 0.58, -0.3, 0.42, 1.7, -0.42, 1.7) | round(0.1)
cockpit_cut = extrude(cockpit_plan, 1.2) | move(0, cockpit_floor + 0.6, 0)
hull_cut = hull_shaped - cockpit_cut

# Paint: topsides, then the deck, antifouling, boot-top and, last, the well
# (the last decal wins where regions overlap, and the well's floor is under
# the waterline; its region reaches 0.1 below the floor so a coarse mesh's
# floor vertices are still inside it).
waterline = up + 0.42
deck_region = cylinder(sheer_r + 0.03, 6.2) | rotate(z=90) | move(0, up + sheer_mid + sheer_r, 0)
boot_region = box(8, 0.1, 8) | move(0, waterline + 0.05, 0)
bottom_region = box(8, 2, 8) | move(0, waterline - 1, 0)
well_region = extrude(cockpit_plan | offset(0.03), 1.4) | move(0, cockpit_floor + 0.6, 0)
hull = hull_cut | paint(topside) | decal(deck_region, deckpaint)
  | decal(bottom_region, antifoul) | decal(boot_region, boot) | decal(well_region, cockpitpaint)

# Gunwale: a rubbing strake along the deck edge; each point is the edge
# corner, found by surface() from a guess just outside and above it.
gw_st = [-2.0, 0.7, -1.5, 0.84, -1.0, 0.9, -0.5, 0.92, 0, 0.9, 0.5, 0.88, 1.0, 0.8, 1.5, 0.65, 2.0, 0.42, 2.3, 0.2]
gw_pts = []
gn = len(gw_st) / 2
q0 = surface(hull_cut, 0.65, sheer(-2.4) + 0.1, -2.5)
gw_pts = gw_pts + q0
for i in range(gn) { gw_pts = gw_pts + surface(hull_cut, gw_st[2 * i + 1] + 0.1, sheer(gw_st[2 * i]) + 0.1, gw_st[2 * i]) }
gw_pts = gw_pts + surface(hull_cut, 0, sheer(2.5) + 0.1, 2.6)
for i in range(gn) { j = gn - 1 - i
  gw_pts = gw_pts + surface(hull_cut, -gw_st[2 * j + 1] - 0.1, sheer(gw_st[2 * j]) + 0.1, gw_st[2 * j]) }
q1 = surface(hull_cut, -0.65, sheer(-2.4) + 0.1, -2.5)
gw_pts = gw_pts + q1 + q0
gunwale = tube(0.05, gw_pts, smooth=2) | paint(varnish)

# Thwart across the cockpit, centreboard under the keel, mast step on deck.
thwart = box(1.2, 0.06, 0.3) | move(0, up + 0.62, -0.7) | paint(varnish)
centreboard = box(0.08, 1.3, 0.8, round=0.03) | move(0, up - 0.25, 0.1) | paint(foil)
mast_z = 0.6
mast_step = cylinder(0.1, 0.12) | move(0, sheer(mast_z) + 0.02, mast_z) | paint("steel")

# ---------- deck fittings (the rigging ends on these) ----------
stem_fitting = box(0.12, 0.1, 0.2) | move(0, sheer(2.38) + 0.03, 2.38) | paint("steel")
quarter_p = cylinder(0.04, 0.3) | move(-0.46, up + 1.1, -2.3) | paint("steel")
quarter_s = cylinder(0.04, 0.3) | move(0.46, up + 1.1, -2.3) | paint("steel")
fairlead = box(0.1, 0.06, 0.12) | move(-0.72, sheer(-0.1) + 0.02, -0.1) | paint("steel")

# ---------- mast ----------
masthead_y = sheer(mast_z) + 5.0
mast = cylinder(0.075, masthead_y - up - 0.7) | move(0, (masthead_y + up + 0.7) / 2, mast_z) | paint(spar)
masthead = sphere(0.08) | move(0, masthead_y, mast_z) | paint("steel")
# A crane across the masthead with a tang each side, so the two shrouds
# leave from separate points instead of a sub-cell wedge at one point.
crane = box(0.44, 0.06, 0.08) | anchor("port", -0.2, 0, 0) | anchor("stbd", 0.2, 0, 0)
  | move(0, masthead_y - 0.08, mast_z) | paint("steel")
gooseneck_y = sheer(mast_z) + 0.75
gooseneck = cylinder(0.09, 0.12) | move(0, gooseneck_y, mast_z) | paint("steel")

# ---------- boom and mainsail (a joint at the gooseneck) ----------
boom_len = 2.0
boom = tube(0.045, [0, gooseneck_y, mast_z, 0, gooseneck_y, mast_z - boom_len], cap="flat") | paint(varnish)
boom_end = sphere(0.06) | anchor("end", 0, 0, 0) | move(0, gooseneck_y, mast_z - boom_len) | paint("steel")

# A sail is drawn flat in x/y with its luff vertical at x = +half and its
# foot from +half to -half; wrap() gives it a belly, rotate(y=-90) turns it
# to lie along z with the belly to -x (port), and the move puts the luff
# back on the mast axis. The luff edge overshoots the axis by `lap` so the
# spar or stay it hangs on lies inside the cloth; the belly's curvature
# carries the edge 0.017 off the axis over that overshoot, so the move uses
# the angle halfway along it and the cloth is thick enough to keep the
# stay inside (measured: a 0.03 stay in 0.1 cloth left open edges).
cloth = 0.12
lap = 0.05
main_head_y = masthead_y - 0.12
main_r = 2.5
mh = boom_len / 2
# The foot sits 0.03 above the boom's axis so the cloth's faces cross the
# boom's side steeply instead of grazing it (measured: open edges on the axis).
foot_y = gooseneck_y + 0.03
main_pts = [mh + lap, foot_y, -mh, foot_y]
leech_dx = 2 * mh
leech_dy = main_head_y - foot_y
leech_len = sqrt(leech_dx * leech_dx + leech_dy * leech_dy)
for t in [0.2, 0.4, 0.6, 0.8] {
  main_pts = main_pts + [-mh + t * leech_dx - 0.12 * sin(180 * t) * leech_dy / leech_len,
                         foot_y + t * leech_dy + 0.12 * sin(180 * t) * leech_dx / leech_len] }
main_pts = main_pts + [mh + lap, main_head_y]
main_flat = extrude(polygon(main_pts), cloth, "z")
main_luff_deg = (mh + lap / 2) / main_r * 57.2958
mainsail = main_flat | wrap(main_r) | rotate(y=-90)
  | move(main_r * cos(main_luff_deg), 0, -main_r * sin(main_luff_deg) + mast_z) | paint(sailcloth)
boom_rig = joint(boom + boom_end + mainsail, "boom", 0, gooseneck_y, mast_z)

# ---------- jib ----------
# Luff along the forestay from the stem fitting towards the masthead; drawn
# with the luff vertical, bellied, then tilted by the forestay's rake.
tack = at(stem_fitting, "centre")
head = at(masthead, "centre")
fs_dy = head[1] - tack[1]
fs_dz = head[2] - tack[2]
fs_len = sqrt(fs_dy * fs_dy + fs_dz * fs_dz)
rake = atan(-fs_dz, fs_dy)
jib_luff = fs_len - 0.05
# the clew, given in the world, expressed along (cu) and across (cv) the luff
clew_y = up + 1.3
clew_z = 0.95
cu = (clew_y - tack[1]) * cos(rake) + (tack[2] - clew_z) * sin(rake)
cv = -(clew_y - tack[1]) * sin(rake) + (tack[2] - clew_z) * cos(rake)
jh = cv / 2
jib_r = 2
jib_flat = extrude(polygon(jh + lap, 0, -jh, cu, jh + lap, jib_luff), cloth, "z")
jib_luff_deg = (jh + lap / 2) / jib_r * 57.2958
jib = jib_flat | wrap(jib_r) | rotate(y=-90)
  | move(jib_r * cos(jib_luff_deg), 0, -jib_r * sin(jib_luff_deg))
  | rotate(x=-rake) | move(tack[0], tack[1], tack[2]) | paint(sailcloth)

# ---------- rudder and tiller (a joint on the stock) ----------
stock_z = -2.47
gudgeon_hi = box(0.14, 0.08, 0.24) | move(0, up + 1.0, -2.4) | paint("steel")
gudgeon_lo = box(0.14, 0.08, 0.24) | move(0, up + 0.5, -2.4) | paint("steel")
stock = cylinder(0.035, 1.0) | move(0, up + 0.65, stock_z) | paint("steel")
blade = box(0.06, 1.25, 0.42, round=0.02) | move(0, up - 0.05, stock_z - 0.16) | paint(foil)
rudder_head = box(0.1, 0.3, 0.26, round=0.02) | move(0, up + 1.05, stock_z - 0.02) | paint(varnish)
tiller = box(0.06, 0.05, 1.3, round=0.01) | move(0, up + 1.14, stock_z + 0.6) | paint(varnish)
helm_rig = joint(stock + blade + rudder_head + tiller, "helm", 0, up + 1.0, stock_z)

# ---------- rigging: every line runs fitting to fitting ----------
line_r = 0.035
forestay = tube(line_r, [at(masthead, "centre"), at(stem_fitting, "centre")]) | paint("steel")
shroud_p = tube(line_r, [at(crane, "port"), at(quarter_p, "top")]) | paint("steel")
shroud_s = tube(line_r, [at(crane, "stbd"), at(quarter_s, "top")]) | paint("steel")
bridle = tube(line_r, [at(quarter_p, "top"), at(quarter_s, "top")]) | paint("steel")
qp = at(quarter_p, "top")
qs = at(quarter_s, "top")
bridle_mid = [(qp[0] + qs[0]) / 2, qp[1], qp[2]]
# at(boom_rig, "end") is the boom end where the pose puts it
mainsheet = tube(line_r, [at(boom_rig, "end"), bridle_mid]) | paint("steel")
jib_clew = [0, clew_y, clew_z]
jibsheet = tube(line_r, [jib_clew, at(fairlead, "centre")]) | paint("steel")

# ---------- cradle ----------
# Two beams on the floor joined by rails; a post at each corner leans in
# to the hull's bottom panel. surface() from far below slid to the keel in
# the loft's field, so the guess is just under the panel (about y = 0.2
# above the keel at x = 0.5).
floor_y = 0
beam_a = box(2.2, 0.14, 0.16) | move(0, floor_y + 0.07, -1.3)
beam_b = box(2.2, 0.14, 0.16) | move(0, floor_y + 0.07, 1.0)
rail_p = box(0.12, 0.12, 2.5) | move(-0.9, floor_y + 0.06, -0.15)
rail_s = box(0.12, 0.12, 2.5) | move(0.9, floor_y + 0.06, -0.15)
posts = empty()
pads = empty()
for x in [-0.5, 0.5] {
  for z in [-1.3, 1.0] {
    p = surface(hull_cut, x, up + 0.1, z)
    posts = posts + tube(0.06, [x * 1.5, floor_y + 0.1, z, p[0], p[1] + 0.02, p[2]], cap="flat")
    pads = pads + (sphere(0.09) | move(p[0], p[1], p[2])) } }
cradle = (beam_a + beam_b + rail_p + rail_s + posts) | paint("wood") + (pads | paint("rubber"))

boat = hull + gunwale + thwart + centreboard + mast_step + stem_fitting + quarter_p + quarter_s + fairlead
  + mast + masthead + crane + gooseneck + boom_rig + jib + gudgeon_hi + gudgeon_lo + helm_rig
  + forestay + shroud_p + shroud_s + bridle + mainsheet + jibsheet
sailboat = boat + cradle

pose("rest")
pose("sailing", boom=[0, 35, 0], helm=[0, -20, 0])
animation("tack", ["rest", "sailing", "rest"], seconds=3)
show sailboat
