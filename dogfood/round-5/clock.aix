# A grandfather clock, about 6 units tall, front on +z.
# Plinth, glazed waist with the pendulum inside, hood with dial and cornice.
# Hands and pendulum are joints; numerals and chapter ring are decals on the brass dial.

set grid 256
set azimuth 28
set elevation 10
set light_azimuth -20
set light_elevation 30
set ambient 1.8

wood = "walnut"
blued = material("#2a3550", metal=1, rough=0.3)

# --- plinth ---
base_mould = box(1.9, 0.18, 1.12, round=0.03) | move(0, 0.09, 0) | paint(wood)
plinth = box(1.72, 0.8, 1.0, round=0.02) | move(0, 0.55, 0) | paint(wood)
plinth_cap = box(1.82, 0.08, 1.06, round=0.02) | move(0, 0.94, 0) | paint(wood)

# --- waist: a hollow box with a glazed door in its front wall ---
waist_y0 = 0.9
waist_h = 3.0
waist_solid = box(1.3, waist_h, 0.8, round=0.02) | move(0, waist_y0 + waist_h / 2, 0)
waist_shell = shell(waist_solid, 0.08)
door_cut = box(0.8, 2.2, 0.3) | move(0, waist_y0 + waist_h / 2, 0.4)
waist_body = (waist_shell - door_cut) | paint(wood) | decal(box(1.2, 2.9, 0.68) | move(0, waist_y0 + waist_h / 2, 0), "tan")
door_frame = extrude(rect(0.98, 2.38, round=0.02) - rect(0.8, 2.2), 0.06, "z") | move(0, waist_y0 + waist_h / 2, 0.41) | paint(wood)
glass = box(0.86, 2.26, 0.045) | move(0, waist_y0 + waist_h / 2, 0.36) | paint(material("glass", transmit=0.95))
waist = waist_body + door_frame + glass

# --- pendulum: a joint at its suspension point inside the waist's top wall ---
sus_y = 3.86
bob_y = 1.5
rod = cylinder(0.035, sus_y - bob_y + 0.1) | move(0, (sus_y + bob_y) / 2, 0) | paint("steel")
bob = cylinder(0.27, 0.07, round=0.02) | rotate(x=90) | move(0, bob_y, 0) | paint("brass")
bob_boss = cylinder(0.08, 0.1) | rotate(x=90) | move(0, bob_y, 0) | paint("brass")
pendulum = joint(rod + bob + bob_boss, "pendulum", 0, sus_y, 0)

# --- hood ---
hood_y0 = 3.85
hood_h = 1.55
hood_solid = box(1.66, hood_h, 0.95, round=0.02) | move(0, hood_y0 + hood_h / 2, 0)
hood_recess = box(1.4, 1.36, 0.2) | move(0, 4.62, 0.475 + 0.04)
hood_body = (hood_solid - hood_recess) | paint(wood)
column = cylinder(0.06, 1.36) | move(0, 4.62, 0.43) | paint(wood)
columns = mirror(column | move(0.74, 0, 0), "x")
cornice_1 = box(1.82, 0.1, 1.04, round=0.02) | move(0, hood_y0 + hood_h + 0.03, 0) | paint(wood)
cornice_2 = box(1.94, 0.12, 1.12, round=0.03) | move(0, hood_y0 + hood_h + 0.13, 0) | paint(wood)
pediment = box(0.5, 0.16, 0.6, round=0.03) | move(0, hood_y0 + hood_h + 0.25, 0) | paint(wood)
finial = sphere(0.09) | move(0, hood_y0 + hood_h + 0.36, 0) | paint("brass")
hood = hood_body + columns + cornice_1 + cornice_2 + pediment + finial

# --- dial ---
dial_y = 4.72
dial_z = 0.42
dial_r = 0.5
dial_plate = cylinder(dial_r, 0.08) | rotate(x=90) | move(0, dial_y, dial_z) | paint("brass")
chapter_region = extrude(circle(0.49) - circle(0.31), 0.4, "z") | move(0, dial_y, dial_z + 0.04)
numerals = ["XII", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI"]
numeral_region = empty()
i = 0
for n in numerals {
  glyph = extrude(text(n, 0.085, weight=0.02, align="center"), 0.4, "z") | move(0, 0.355, 0) | rotate(z=-30 * i)
  numeral_region = numeral_region + glyph
  i = i + 1
}
numeral_region = numeral_region | move(0, dial_y, dial_z + 0.04)
tick = box(0.012, 0.03, 0.4) | move(0, 0.475, 0)
tick_region = ring(tick, 60) | move(0, dial_y, dial_z + 0.04)
dial = dial_plate | decal(chapter_region, "ivory") | decal(tick_region, "black") | decal(numeral_region, "black")
bezel = torus(dial_r + 0.03, 0.045) | rotate(x=90) | move(0, dial_y, dial_z + 0.02) | paint("brass")
hub = cylinder(0.05, 0.2) | rotate(x=90) | move(0, dial_y, dial_z + 0.08) | paint(blued)

# --- hands: two joints at the dial's centre, pointing to 12 at rest ---
hour_z = dial_z + 0.05
minute_z = dial_z + 0.145
hour_hand = (extrude(polygon(-0.045,-0.08, 0.045,-0.08, 0.018,0.33, -0.018,0.33), 0.06, "z") | move(0, dial_y, hour_z)) | paint(blued)
minute_hand = (extrude(polygon(-0.04,-0.1, 0.04,-0.1, 0.016,0.45, -0.016,0.45), 0.05, "z") | move(0, dial_y, minute_z)) | paint(blued)
hour = joint(hour_hand, "hour", 0, dial_y, hour_z)
minute = joint(minute_hand, "minute", 0, dial_y, minute_z)

# --- maker's plate under the dial ---
plate = box(1.0, 0.2, 0.08, round=0.01) | move(0, 4.035, dial_z + 0.01) | paint("brass")
maker_text = extrude(text("FABLE", 0.14, weight=0.032, spacing=0.04, align="center", face="serif"), 0.05, "z") | move(0, 4.035 - 0.07, dial_z + 0.06) | paint(blued)
maker = plate + maker_text

clock = base_mould + plinth + plinth_cap + waist + pendulum + hood + dial + bezel + hub + hour + minute + maker

pose("rest")
pose("three", hour=[0, 0, -90])
pose("ten_ten", hour=[0, 0, 55], minute=[0, 0, -60])
pose("swing", pendulum=[0, 0, 8])
pose("swing_back", pendulum=[0, 0, -8])
pose("show", hour=[0, 0, 55], minute=[0, 0, -60], pendulum=[0, 0, -8])
animation("tick", ["swing", "swing_back", "swing"], seconds=2)

show clock
