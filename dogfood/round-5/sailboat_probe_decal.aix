# Probe: which decal wins where two regions overlap?
# a: the big region first, then the small one; b: the reverse.
big = box(3, 3, 3)
small = box(3, 1, 3)
a = box(2, 2, 2) | paint("blue") | decal(big, "red") | decal(small, "green") | move(-1.5, 1, 0)
b = box(2, 2, 2) | paint("blue") | decal(small, "green") | decal(big, "red") | move(1.5, 1, 0)
show a, b
