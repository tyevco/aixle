# A chess set on its board, in the starting position. The board is 4 units
# across (8 squares of 0.45 in a 0.2 border), the king 0.5 tall. The six
# piece defs come from chess_pieces.aix and serve both colours; the board
# and the two armies are the three objects of the scene. White sits at the
# front (+z); the black knights are turned to face white.
use "chess_pieces" as p
set grid 320
set azimuth 30
set elevation 28

sq = 0.45                 # a square
top_y = 0.15              # the playing surface
a1 = -3.5 * sq            # the a-file's x; the 1st rank's z is -a1

# Materials: boxwood and ebony pieces, maple and walnut squares, a walnut border.
boxwood = material("#e6c98c", "wood", "#c9a75e", scale=0.05, rough=0.5)
ebony = material("ebony", scale=0.05)
maple = material("#eddcae", "wood", "#d9c084", scale=0.4, axis="x", rough=0.4)
walnut_sq = material("walnut", scale=0.4, axis="x", rough=0.4)
walnut_rim = material("walnut", scale=0.5, axis="z", rough=0.5)

# The board: a slab with a recessed field, so the border stands 0.03 proud.
# The squares are decals on the field's floor: the region boxes straddle it.
slab = box(4, 0.18, 4, round=0.01) | move(0, 0.09, 0)
recess = box(8 * sq, 0.2, 8 * sq) | move(0, top_y + 0.1, 0)
body = (slab - recess) | paint(walnut_rim)
field = box(8 * sq, 0.06, 8 * sq) | move(0, top_y, 0)
tile = box(sq, 0.06, sq) | move(a1, top_y, -a1)                  # a1, front left, dark
darks = (tile | grid(4, 4, 2 * sq, -2 * sq)) + (tile | move(sq, 0, -sq) | grid(4, 4, 2 * sq, -2 * sq))
board = body | decal(field, maple) | decal(darks, walnut_sq)

# A square's centre on the playing surface: file 0..7, rank 1..8.
def square(f, r) = [a1 + f * sq, top_y, -a1 - (r - 1) * sq]
# Placements (x, y, z, yaw) for a pair of pieces on a rank at two files, and for a rank of pawns.
def rank_of(r, yaw, files) =
  square(files[0], r) + [yaw] + square(files[1], r) + [yaw]
def pawn_rank(r, yaw) =
  square(0, r) + [yaw] + square(1, r) + [yaw] + square(2, r) + [yaw] + square(3, r) + [yaw]
  + square(4, r) + [yaw] + square(5, r) + [yaw] + square(6, r) + [yaw] + square(7, r) + [yaw]

# White: boxwood, ranks 1 and 2, facing +z.
w_rooks = place(p.rook() | paint(boxwood), rank_of(1, 0, [0, 7]))
w_knights = place(p.knight() | paint(boxwood), rank_of(1, 0, [1, 6]))
w_bishops = place(p.bishop() | paint(boxwood), rank_of(1, 0, [2, 5]))
w_queen = p.queen() | paint(boxwood) | move(square(3, 1)[0], top_y, square(3, 1)[2])
w_king = p.king() | paint(boxwood) | move(square(4, 1)[0], top_y, square(4, 1)[2])
w_pawns = place(p.pawn() | paint(boxwood), pawn_rank(2, 0))
white = w_rooks + w_knights + w_bishops + w_queen + w_king + w_pawns

# Black: ebony, ranks 8 and 7, turned to face -z.
b_rooks = place(p.rook() | paint(ebony), rank_of(8, 180, [0, 7]))
b_knights = place(p.knight() | paint(ebony), rank_of(8, 180, [1, 6]))
b_bishops = place(p.bishop() | paint(ebony), rank_of(8, 180, [2, 5]))
b_queen = p.queen() | paint(ebony) | move(square(3, 8)[0], top_y, square(3, 8)[2])
b_king = p.king() | paint(ebony) | move(square(4, 8)[0], top_y, square(4, 8)[2])
b_pawns = place(p.pawn() | paint(ebony), pawn_rank(7, 180))
black = b_rooks + b_knights + b_bishops + b_queen + b_king + b_pawns

scene board, w_rooks, w_knights, w_bishops, w_queen, w_king, w_pawns, b_rooks, b_knights, b_bishops, b_queen, b_king, b_pawns
