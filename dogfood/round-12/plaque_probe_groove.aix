# PROBE: plaque.aix with one engraved line, SIT AND SHARE IT, cut 1.7 mm deep (its
# floor at y = 3.3) where the other two are 2: does the groove probe, one region over
# all three lines, catch a local defect? The floor rises 0.2 into the probe (from 3.1).
# A cast brass plaque to be screwed to a park bench, 200 x 80 mm.
# Built lying face up on y = 0: the face is +y, the plaque's top edge is
# towards -z, so it reads from the front (+z). A 5 mm plate, a raised
# border 6 mm wide and 2 mm proud, a raised serif title, three engraved
# lines under it, and two countersunk screw holes through the ends.
set units mm
set grid 300

p = {w: 200, d: 80, corner: 8, base: 5, border_w: 6, relief: 2, engrave: 2}
hole = {x: 86, r: 2.25, sink_r: 5}

# The outline and the field inside the border, as 2D profiles (x across, y up the plaque).
outline = rect(p.w, p.d, round=p.corner)
inner = offset(outline, -p.border_w)

# The finish of a cast plaque: the raised border and letters polished, the field
# left satin with the casting's fine grain.
polished = material("brass", rough=0.28)
field = material("brass", rough=0.4, bump=0.06, bump_scale=0.5)

# The plate, 0..5 mm, and the border band 4.5..7 (sunk 0.5 into the plate).
base = extrude(outline, p.base) | move(0, p.base / 2, 0) | paint(field)
border = extrude(outline - inner, p.relief + 0.5) | move(0, p.base + (p.relief - 0.5) / 2, 0) | paint(polished)

# The title, raised as high as the border.
title_text = text("EDITH MARLOWE", 11, weight=1.7, align="center", face="serif", spacing=2) | move(0, 12.7)
title = extrude(title_text, p.relief + 0.5) | move(0, p.base + (p.relief - 0.5) / 2, 0) | paint(polished)

# Three engraved lines, 2 mm deep; the cutter runs from the floor (y = 3) to past the face.
ln = {size: 7.5, weight: 1.4, spacing: 1.2}
def line(s, y, w) = text(s, ln.size, weight=w, align="center", spacing=ln.spacing) | move(0, y)
def lines(w) = line("1931 - 2019", -0.8, w) + line("SHE LOVED THIS VIEW", -12.3, w) + line("SIT AND SHARE IT", -23.8, w)
engraving = extrude(lines(ln.weight), p.engrave + 1) | move(0, p.base - p.engrave + (p.engrave + 1) / 2, 0)
  - extrude(line("SIT AND SHARE IT", -23.8, ln.weight + 1), 0.4) | move(0, p.base - p.engrave + 0.1, 0)

# A countersunk hole: a 4.5 mm shank through, a 90 degree countersink 10 mm across at the face.
shank = cylinder(hole.r, 20)
sink_h = hole.sink_r + 1 - hole.r
sink = cone(hole.r, hole.sink_r + 1, sink_h) | move(0, p.base - (hole.sink_r - hole.r) + sink_h / 2, 0)
holes = (shank + sink) | move(hole.x, 0, 0) | mirror("x")

plaque = (base + border + title) - engraving - holes

# Promises.
# One rod down each hole, past both faces (a region made by mirror("x") spans both
# holes and its lattice missed a 0.25 mm skin closing them; see the report).
rod_l = cylinder(1.2, 14) | move(-hole.x, 2.5, 0)
rod_r = cylinder(1.2, 14) | move(hole.x, 2.5, 0)
assert void(rod_l, plaque) == 1, "the left screw hole goes through"
assert void(rod_r, plaque) == 1, "the right screw hole goes through"
assert clearance(rod_l, plaque) > 0.9, "the left hole is open round its probe"
assert clearance(rod_r, plaque) > 0.9, "the right hole is open round its probe"
thin = lines(0.4)
groove_probe = extrude(thin, p.engrave - 0.2) | move(0, p.base - p.engrave + 0.1 + (p.engrave - 0.2) / 2, 0)
floor_probe = extrude(thin, 0.3) | move(0, p.base - p.engrave - 0.1 - 0.15, 0)
assert void(groove_probe, plaque) == 1, "the engraving is open at least 1.9 mm deep"
assert inside(floor_probe, plaque) > 0.99, "and floored no deeper than 2.1 mm"
assert clearance(title, border) > 8, "the title stands clear of the border"
assert clearance(engraving, border) > 5, "the engraved lines stand clear of the border"
assert clearance(title, holes) > 3, "the title clears the screw holes"
assert clearance(engraving, holes) > 3, "the engraving clears the screw holes"
assert pieces(plaque) == 1, "one casting"

# The key stands behind and to the right, near (not in) the direction the face mirrors
# to the camera (azimuth 180, elevation 55): the flat brass shows its colour as a
# gradient without clipping to lemon. A fill from the front left lights the letters' walls.
light("key", azimuth=160, elevation=40, size=4, power=0.45)
light("fill", azimuth=-30, elevation=35, size=3, power=0.5)
camera("hero", azimuth=0, elevation=55, zoom=1.1)
set camera hero
show plaque
