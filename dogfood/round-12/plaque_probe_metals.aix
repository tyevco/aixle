# Probe: brass beside gold, bronze and a brass of my own, under the plaque's lights
# and camera, to see whether the preset brass reads as brass and not gold.
set units mm
set grid 160

def tile(m) = box(44, 5, 70, round=1) | move(0, 2.5, 0) | paint(m)
a = tile("brass") | move(-75, 0, 0)
b = tile("gold") | move(-25, 0, 0)
c = tile("bronze") | move(25, 0, 0)
d = tile(material("brass", rough=0.5)) | move(75, 0, 0)
label = extrude(text("BRASS  GOLD  BRONZE  BRASS.5", 6, weight=1, align="center"), 2, "z") | move(0, 3, 37)

light("key", azimuth=160, elevation=40, size=4, power=0.45)
light("fill", azimuth=-30, elevation=35, size=3, power=0.5)
camera("hero", azimuth=0, elevation=55, zoom=1.1)
set camera hero
show a + b + c + d
