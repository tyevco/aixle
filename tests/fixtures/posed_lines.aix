# check --pose prints a posed line for every step a joint turns: one assigned twice (shell, painted then decalled),
# and a plain union read by a larger one (hinged), which the union of unions flattens into one list.
shell = box(1, 0.6, 2) | move(0, 1.3, 0) | paint("red")
shell = decal(shell, box(2, 2, 0.1) | move(0, 1.3, 0.5), "white")
knuckle = cylinder(0.15, 0.8) | rotate(z=90) | move(0, 1, -1)
hinged = shell + knuckle
nose = sphere(0.3) | move(0, 1.3, 1.1)
head = joint(hinged + nose, "tilt", 0, 1, -1, axis=[1, 0, 0])
base = box(1.2, 1, 2.4) | move(0, 0.5, 0)
pose("up", tilt=-60)
show base + head
