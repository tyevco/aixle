# A worn iron lantern with a candle burning inside: the PBR finish. The iron is the
# rust preset (patches of rough oxide on the metal) with wear, which rubs the edges
# back to bright iron and darkens the corners, and a slight bump for a hammered
# skin; the wax has bumps of its own and the flame glows. None of it adds geometry:
# the beauty render shades it from the field, and the GLB carries it as a normal
# map, a metallic-roughness map and an emissive flame.
iron = material("rust", wear=0.45, bump=0.003, bump_scale=0.05)
wax = material("#efe2c4", rough=0.5, bump=0.003, bump_scale=0.04, wear=0.3)
flame_mat = material("#ffd27a", "noise", color2="#ff8a2a", scale=0.04, glow=1.6)

base = box(1.4, 0.16, 1.4, round=0.03) | move(0, 0.08, 0)
post = box(0.1, 1.78, 0.1) | move(0.62, 1.01, 0.62)
posts = mirror(mirror(post, "x"), "z")
top = box(1.4, 0.14, 1.4, round=0.03) | move(0, 1.93, 0)
bar = cylinder(0.03, 1.78) | move(-0.3, 1.01, 0.64) | array(3, 0.3, 0, 0)
bars = mirror(bar, "z") + mirror(bar | rotate(y=90), "x")
roof = loft(rect(1.5, 1.5), rect(0.34, 0.34), 0.6) | move(0, 2.28, 0)
chimney = cylinder(0.13, 0.22, round=0.02) | move(0, 2.66, 0)
handle = torus(0.3, 0.045) | rotate(x=90) | move(0, 3.04, 0)
frame = (base + posts + top + bars + roof + chimney + handle) | paint(iron)

candle = cylinder(0.2, 0.7, round=0.04) | move(0, 0.49, 0) | paint(wax)
wick = cylinder(0.025, 0.2) | move(0, 0.9, 0) | paint("black")
flame = sphere(0.07) | scale(1, 2.1, 1) | move(0, 1.07, 0) | paint(flame_mat)
lantern = frame + candle + wick + flame

light("key", azimuth=-35, elevation=40, size=1.5)
light("rim", azimuth=150, elevation=25, power=0.45, color="#cfe0ff")
light("flame", position=[0.1, 1.03, 0.4], range=1.4, color="#ffb060", power=1.3)
show lantern

assert pieces(lantern, 128) == 1, "the candle stands a cell into the base, the wick in the candle, the flame on the wick"
assert clearance(candle, posts) > 0.2, "the candle clears the posts"
