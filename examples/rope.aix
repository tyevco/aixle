# A coil of rope on a wooden spool. The rope is three strands, each a
# circle, swept along a helix with a full twist per turn so the strands
# wind around each other; the spool is two revolved discs on a tube.
strand = circle(0.11)
strands = (strand | move(0.12, 0)) + (strand | move(0.12, 0) | rotate(120)) + (strand | move(0.12, 0) | rotate(240))
turns = 5
coil = sweep(strands, helix(1.0, 1.4, turns, per_turn=24), twist = 360 * turns) | move(0, 0.55, 0) | paint("tan")
core = cylinder(0.9, 2.4) | move(0, 1.25, 0)
flange = revolve(polygon(0,0, 1.7,0, 1.75,0.12, 1.55,0.25, 0,0.25))
spool = (core + flange + (flange | move(0, 2.25, 0))) | paint("oak")
axle = cylinder(0.18, 3.0) | move(0, 1.25, 0) | paint("iron")
reel = (spool + coil + axle) | ground()
show reel
