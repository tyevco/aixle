# A teapot: a revolved body hollowed with shell() and opened at the top, a
# revolved lid, a spout that is a tube along a smoothed path, and a handle
# that is an ellipse swept along another. Paths are flat lists of x, y, z.
body = revolve(polygon(0,0, 1.6,0, 2.1,0.7, 2.05,1.5, 1.4,2.3, 1.15,2.5, 0,2.5))
pot = shell(body, 0.12) - (cylinder(1.0, 1.0) | move(0, 2.6, 0))
lid = revolve(polygon(0,0, 1.12,0, 1.1,0.12, 0.6,0.3, 0.3,0.42, 0,0.42)) | move(0, 2.5, 0)
knob = sphere(0.2) | move(0, 3.05, 0) | paint("gold")
spout_path = [1.7,0.9,0, 2.4,1.2,0, 2.9,1.9,0, 3.05,2.6,0]
spout = tube(0.19, spout_path, smooth=6) - tube(0.11, spout_path, smooth=6)
handle_path = [-1.85,0.9,0, -2.75,1.3,0, -2.85,2.2,0, -1.75,2.45,0]
handle = sweep(ellipse(0.11, 0.2), handle_path, smooth=6)
china = (pot + lid + spout + handle) | paint("porcelain")
teapot = (china + knob) | ground()
show teapot
