# A teapot: a revolved body hollowed with shell() and opened at the top, a
# revolved lid, a spout that is a tube along a smoothed path, and a handle
# that is an ellipse swept along another. Paths are flat lists of x, y, z.
# Spout and handle start inside the body and are cut back to its inner wall
# (the body shrunk by the wall with offset()), so both meet the pot. The
# spout is cut flat at its tip, and its bore, a thinner round-ended tube on
# the same path, is cut from spout and pot together: it runs through the
# pot's wall and out past the tip, open at both ends.
body = revolve(polygon(0,0, 1.6,0, 2.1,0.7, 2.05,1.5, 1.4,2.3, 1.15,2.5, 0,2.5))
inside = offset(body, -0.12)
pot = shell(body, 0.12) - (cylinder(1.0, 1.0) | move(0, 2.6, 0))
lid = revolve(polygon(0,0, 1.12,0, 1.1,0.12, 0.6,0.3, 0.3,0.42, 0,0.42)) | move(0, 2.5, 0)
knob = sphere(0.2) | move(0, 3.05, 0) | paint("gold")
spout_path = [1.7,0.9,0, 2.4,1.2,0, 2.9,1.9,0, 3.05,2.6,0]
spout = tube(0.2, spout_path, smooth=6, cap="flat") - inside
bore = tube(0.12, spout_path, smooth=6)
handle_path = [-1.85,0.9,0, -2.75,1.3,0, -2.85,2.2,0, -1.3,2.2,0]
handle = sweep(ellipse(0.11, 0.2), handle_path, smooth=6) - inside
china = (pot + spout + handle - bore + lid) | paint("porcelain")
teapot = (china + knob) | ground()
# One piece, and still one with the handle cut through its middle, so both
# its ends hold; a rod down the spout and out past its tip touches nothing,
# so the bore is open from inside the pot through the tip.
assert pieces(teapot) == 1
assert pieces(china - (box(0.6, 0.2, 1) | move(-2.85, 1.75, 0))) == 1
assert void(tube(0.1, spout_path + [3.1,2.9,0], smooth=6), china) == 1
show teapot
