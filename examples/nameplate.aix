# A desk nameplate: a walnut wedge with a brass plate on its leaning face,
# two lines of serif lettering engraved into the plate, and a brass scroll
# at each end swept along one exact Bezier curl.

set grid 220

# The wedge, drawn as a side profile (its x runs along -z, y up) and extruded along x:
# 1.4 deep at the foot, its front (+z) face leaning back 19 degrees.
side = polygon(0.7,0, -0.7,0, -0.15,1.6, 0.7,1.6)
body = extrude(side, 6.4, "x") | paint("walnut")

# The face normal is (0, sin 19, cos 19); the plate is centred 0.06 out from the face midpoint (0, 0.8, 0.425).
plate = extrude(rect(5.6, 1.1, round=0.08), 0.12, "z") | rotate(x=-19) | move(0, 0.8 + 0.06 * 0.326, 0.425 + 0.06 * 0.946) | paint("brass")

# Lettering, extruded 0.2 and centred on the plate's front, so subtracting it engraves 0.1 deep.
name = extrude(text("Ada Lovelace", 0.42, weight=0.07, align="center", face="serif"), 0.2, "z") | move(0, 0.16, 0)
title = extrude(text("Analyst", 0.26, weight=0.05, align="center", face="serif"), 0.2, "z") | move(0, -0.34, 0)
lettering = (name + title) | rotate(x=-19) | move(0, 0.8 + 0.12 * 0.326, 0.425 + 0.12 * 0.946)
engraved = plate - lettering

# A scroll: a rectangle swept along a Bezier curl (anchor, handle, handle, anchor, ...), drawn in the x/y plane.
curl = bezier([0,0.1,0, 0,1.0,0, 0.75,1.3,0, 0.75,0.55,0, 0.75,-0.05,0, 0.25,0.15,0, 0.4,0.45,0])
scroll = sweep(rect(0.16, 0.2), curl) | paint("brass")
# Turned to lie in the y/z plane against each end of the wedge (0.05 into it), curling towards the front.
scroll_l = scroll | rotate(y=-90) | move(-3.25, 0, -0.5)
scroll_r = scroll | rotate(y=-90) | move(3.25, 0, -0.5)

model = body + engraved + scroll_l + scroll_r | ground()
show model
