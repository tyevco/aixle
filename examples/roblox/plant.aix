# A potted plant for a Roblox place, from the shipped plants library
# scaled to studs (a 0.6 plant is 2.1 studs), on a saucer.
use "std/plants"
set roblox 1
set grid 64

clay = material("#b8623a", rough=0.8)
saucer = cylinder(0.5, 0.08) | move(0, 0.04, 0) | paint(clay)
potted = plants.potted(0.6) | scale(3.5) | move(0, 0.06, 0)
plant = saucer + potted
show plant

assert tall(plant) < 2.5
