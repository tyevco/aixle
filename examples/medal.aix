# A medal on a ribbon: text bent around the rim with arc=, a star in
# relief, a half revolve for the suspension loop, and the ribbon a flat
# profile swept along a spline so it hangs in a smooth curve.
set grid 160
disc = revolve(polygon(0,0, 1.5,0, 1.5,0.14, 1.32,0.2, 0,0.2)) | rotate(x=90) | paint("gold")
# The disc's face is at z = 0.2 after the rotate (check prints each step's
# x, y, z spans), so the relief sits from 0.2 to 0.3.
rim_text = extrude(text("AIXLE MODELS", size=0.32, weight=0.09, arc=1.1), 0.1, "z") | move(0, 0, 0.25) | paint("brass")
under_text = extrude(text("for machines", size=0.24, weight=0.08, arc=-1.1), 0.1, "z") | move(0, 0, 0.25) | paint("brass")
badge = extrude(star(5, 0.55, 0.24), 0.1, "z") | move(0, 0.05, 0.25) | paint("brass")
# The loop: a half revolve sweeps in the ground plane from +z round to -z, so
# it is stood up with rotate(x=-90) to arch over the rim, its feet in the disc.
loop = revolve(circle(0.09), 0.32, 180) | rotate(x=-90) | move(0, 1.42, 0) | paint("gold")
ribbon_path = spline([0,1.75,0, -0.15,2.6,0.1, -0.7,3.4,0.35, -1.6,4.2,0.5])
ribbon = sweep(rect(0.5, 0.12), ribbon_path) | paint("stripes")
ribbon2 = sweep(rect(0.5, 0.12), spline([0,1.75,0, 0.15,2.6,0.1, 0.7,3.4,0.35, 1.6,4.2,0.5])) | paint("stripes")
medal = (disc + rim_text + under_text + badge + loop + ribbon + ribbon2) | ground()
show medal
