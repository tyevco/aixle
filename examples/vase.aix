# A fluted vase: a lathe profile revolved around y, sixteen flutes cut from
# the outside, in marble. The profile is the wall itself, drawn as a closed
# polygon on x >= 0 (x is the radius), so the vase is hollow without a shell().
wall = polygon(
  0, 0,      1.0, 0,     1.2, 0.3,   1.45, 1.2,  1.3, 2.2,
  0.9, 2.9,  0.8, 3.4,   1.0, 3.8,   1.05, 4.0,
  0.9, 4.0,  0.85, 3.8,  0.68, 3.4,  0.78, 2.9,  1.15, 2.2,
  1.3, 1.2,  1.05, 0.35, 0.85, 0.2,  0, 0.2
)
body = revolve(wall)
flute = cylinder(0.14, 2.2) | move(1.5, 1.8, 0)
flutes = ring(flute, 16)
vase = (body - flutes) | paint("marble")
show vase
