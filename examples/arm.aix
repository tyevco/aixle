# A robot arm with three joints. Each part is built in place, then declared
# a joint at its pivot; the forearm is nested inside the upper arm's joint
# so it swings with it. Poses name joint angles; the animation strings them
# together, and the GLB carries it as a glTF animation.
base = cylinder(1.2, 0.3, round=0.05) | move(0, 0.15, 0) | paint("charcoal")
post = cylinder(0.35, 0.9) | move(0, 0.75, 0) | paint("steel")

# The gripper: two fingers on a wrist, hinged at the wrist pivot.
wrist_pivot_x = 4.2
fingers = (box(0.7, 0.12, 0.2) | move(wrist_pivot_x + 0.45, 3.1, 0.2)) + (box(0.7, 0.12, 0.2) | move(wrist_pivot_x + 0.45, 3.1, -0.2))
palm = box(0.3, 0.5, 0.6, round=0.04) | move(wrist_pivot_x + 0.1, 3.1, 0)
hand = joint((palm + fingers) | paint("brass"), "wrist", wrist_pivot_x, 3.1, 0)

# The forearm from the elbow to the wrist, with the hand hanging off it.
forearm_body = capsule(0.22, 2.4) | rotate(z=-90) | move(3.1, 3.1, 0)
elbow_cap = sphere(0.32) | move(2.0, 3.1, 0)
forearm = joint((forearm_body + elbow_cap) | paint("red") + hand, "elbow", 2.0, 3.1, 0)

# The upper arm from the shoulder up to the elbow, carrying the forearm.
upper_body = capsule(0.28, 2.2) | rotate(z=-45) | move(1.0, 2.1, 0)
shoulder_cap = sphere(0.4) | move(0, 1.2, 0)
upper = joint((upper_body + shoulder_cap) | paint("red") + forearm, "shoulder", 0, 1.2, 0)

arm = base + post + upper
pose("rest")
pose("reach", shoulder=[0, 0, 25], elbow=[0, 0, -40], wrist=[0, 0, 15])
pose("curl", shoulder=[0, 0, -30], elbow=[0, 0, 80], wrist=[0, 0, 40])
pose("turn", shoulder=[0, 90, 0], elbow=[0, 0, 30])
animation("wave", ["rest", "reach", "curl", "rest"], seconds=2)
show arm
