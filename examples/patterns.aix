# A plate of the ten material patterns: each on a rounded cube at scale 0.25
# (the feature size in units) with a small cube of the same pattern at scale
# 0.05 beside it and its name in front, so speckle, noise, marble and the
# rest can be seen before one is chosen. Two rows of five.
set grid 300
names = ["solid", "checker", "stripes", "wood", "marble", "noise", "speckle", "brick", "tiles", "dots"]
def cube(size, name, sc) = box(size, size, size, round=size * 0.08) | move(0, size / 2, 0) | paint(material("#c9a44a", name, "#4a3320", scale=sc))
def tile(name) = cube(1, name, 0.25) + (cube(0.4, name, 0.05) | move(0.85, 0, 0.3))
def label(name) = extrude(text(name, 0.3, weight=0.055, spacing=0.08), 0.1, "z") | move(-0.5, 0.02, 0.85) | paint("iron")
def spot(i) = [(i % 5) * 2.1 - 4.2, 0, (i < 5) * -2.4 + 1.2]
plate = (tile(names[0]) + label(names[0])) | move(spot(0)[0], 0, spot(0)[2])
for i in range(1, 10) {
  plate = plate + ((tile(names[i]) + label(names[i])) | move(spot(i)[0], 0, spot(i)[2]))
}
base = box(11.2, 0.12, 6, round=0.04) | move(0, -0.06, -0.55) | paint("#3a3d42")
board = base + plate
set azimuth 12
set elevation 38
set zoom 1.15
show board
