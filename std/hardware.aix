# std/hardware: bolts, nuts, washers, screws, chains and handles.
# Every part is built at the origin. A fastener's head rests on y = 0 with
# its shank going down (-y), so `hex_bolt(0.1, 0.6) | move(x, top, z)` seats
# it on a plate whose top is at `top`; a nut or a washer stands on y = 0; a
# chain runs along +x from the origin at y = 0. Sizes are in model units.
# Use: use "std/hardware"  then  hardware.hex_bolt(0.1, 0.6)

steel = material("steel", rough=0.4)
zinc = material("#b8bcc2", metal=0.9, rough=0.5)

# A hex-head bolt: head across-flats 2r, 0.7r tall, standing on y = 0; the shank r/2 thick reaches len below it.
def hex_bolt(r=0.1, len=0.6) = ((prism(6, r * 1.15, r * 0.7) | move(0, r * 0.35, 0)) + (cylinder(r * 0.5, len) | move(0, -len / 2, 0))) | paint(zinc)

# A round-head screw: a domed head 2r wide on y = 0 with a slot, the shank r/2 thick reaching len below.
def screw(r=0.08, len=0.5) = (((sphere(r) & (box(2 * r, r, 2 * r) | move(0, r * 0.5, 0))) - (box(2 * r, r * 0.3, r * 0.25) | move(0, r * 0.95, 0))) + (cylinder(r * 0.5, len) | move(0, -len / 2, 0))) | paint(steel)

# A hex nut for a bolt of radius r: 0.8r thick, standing on y = 0, with the hole through it.
def nut(r=0.1) = (prism(6, r * 1.15, r * 0.8) - cylinder(r * 0.5, r * 3)) | move(0, r * 0.4, 0) | paint(zinc)

# A flat washer for a bolt of radius r: 2.2r across, 0.15r thick, standing on y = 0.
def washer(r=0.1) = (cylinder(r * 1.1, r * 0.15) - cylinder(r * 0.55, r)) | move(0, r * 0.075, 0) | paint(zinc)

# One chain link: a rounded oval of wire radius r, pitch long, lying flat in the xz plane.
def link(pitch=0.3, r=0.03) = sweep(circle(r), [-pitch / 2 + r * 2, 0, 0, pitch / 2 - r * 2, 0, 0], smooth=0) + (torus(r * 2, r) | move(-pitch / 2 + r * 2, 0, 0)) + (torus(r * 2, r) | move(pitch / 2 - r * 2, 0, 0))

# A chain of n links (rounded to a pair) along +x from the origin, links alternately flat and upright, each hooked through the next.
def chain(n=8, pitch=0.3, r=0.03) = (link(pitch, r) + (link(pitch, r) | rotate(x=90) | move(pitch - r * 4, 0, 0))) | array(n / 2, (pitch - r * 4) * 2, 0, 0) | move(pitch / 2, 0, 0) | paint(steel)

# A bar handle: a rod of radius r spanning w along x, on two feet of height h standing on y = 0.
def handle(w=0.6, r=0.04, h=0.12) = ((cylinder(r, w) | rotate(z=90) | move(0, h, 0)) + (cylinder(r * 1.2, h) | move(-w / 2 + r * 1.2, h / 2, 0)) + (cylinder(r * 1.2, h) | move(w / 2 - r * 1.2, h / 2, 0))) | paint(steel)

# Rendering this file on its own shows every part in a row.
plate = (hex_bolt() | move(-1.2, 0.6, 0)) + (screw() | move(-0.7, 0.5, 0)) + (nut() | move(-0.2, 0, 0)) + (washer() | move(0.3, 0, 0)) + (chain(6) | move(0.6, 0.09, 0)) + (handle() | move(0, 0, 0.8))
show plate
